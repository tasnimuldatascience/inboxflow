{
  "name": "inboxflow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "demo": "pnpm db:seed && pnpm dev",
    "db:migrate": "tsx packages/database/src/cli.ts migrate",
    "db:seed": "tsx packages/database/src/cli.ts seed",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm --filter @inboxflow/web typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:postgres": "tsx scripts/verify-postgres.ts",
    "test:smoke": "node scripts/verify-demo.mjs",
    "build": "tsc --noEmit && pnpm --filter @inboxflow/web build",
    "start:api": "tsx apps/api/src/main.ts",
    "start:worker": "tsx apps/worker/src/main.ts",
    "start:web": "pnpm --filter @inboxflow/web start"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@electric-sql/pglite": "^0.3.14",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "@opentelemetry/api": "1.9.1",
    "amphtml-validator": "^1.0.38",
    "bullmq": "^5.61.2",
    "dotenv": "^17.2.3",
    "fastify": "5.12.5",
    "ioredis": "^5.8.1",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.15.5",
    "eslint": "^9.38.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^4.0.0"
  }
}

NODE_ENV=development
API_PORT=4000
APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
# Omit DATABASE_URL for persistent embedded PostgreSQL in .data/postgres.
# DATABASE_URL=postgresql://inboxflow:local-only-password@localhost:5432/inboxflow
# Generate independently before production; minimum 32 characters each.
SESSION_SECRET=local-only-change-before-production-0123456789
CREDENTIAL_KEY=local-only-encryption-change-before-production-012345
DEMO_MODE=true
EMAIL_SENDER=demo@inboxflow.example
